           integration. Straight-edge base handles kept small. -->
      <Shape x="-51" y="-58" rotation="-0.18" name="ear_left" id="0:103">
        <PointsPath isClosed="true" name="Path">
          <CubicMirroredVertex x="-29" y="10" rotation="-1.08" distance="8"/>
          <CubicMirroredVertex x="-9" y="-25" rotation="-0.32" distance="12"/>
