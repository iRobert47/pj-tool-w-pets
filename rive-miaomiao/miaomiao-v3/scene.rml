            <GradientStop colorValue="FF343335" position="0"/>
            <GradientStop colorValue="FF111213" position="1"/>
          </LinearGradient>
        </Fill>
      </Shape>
    </Node>

    <!-- Body: one tapered asymmetrical silhouette, closer to the first cute Rive. -->
    <Node x="250" y="350" name="body_rig" id="0:200">
