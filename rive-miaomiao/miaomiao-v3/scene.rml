          <GradientStop colorValue="FFEEE1CC" position="0.6"/>
          <GradientStop colorValue="FFE0D0B8" position="1"/>
        </LinearGradient>
      </Fill>
    </Shape>

    <Shape x="250" y="410" name="chair_base">
      <PointsPath isClosed="true" name="Path">
        <CubicMirroredVertex x="-168" y="-23" rotation="-0.10" distance="53"/>
        <CubicMirroredVertex x="168" y="-23" rotation="0.10" distance="53"/>
        <CubicMirroredVertex x="132" y="29" rotation="2.85" distance="48"/>
        <CubicMirroredVertex x="-135" y="29" rotation="-2.85" distance="48"/>
      </PointsPath>
      <Fill name="Fill">
        <LinearGradient startX="0" startY="-23" endX="0" endY="29" name="ChairBaseShade">
          <GradientStop colorValue="FFC2AF9B" position="0"/>
          <GradientStop colorValue="FFA8927D" position="1"/>
        </LinearGradient>
      </Fill>
    </Shape>

    <!-- Soft, subtle contact/ground shadow -- radial fade, not a flat
         translucent disc, so it reads as light falloff rather than a
         graphic shape. -->
    <Shape x="250" y="435" name="ground_shadow">
      <Ellipse width="405" height="39" name="Path"/>
      <Fill name="Fill">
        <RadialGradient startX="0" startY="0" endX="200" endY="0" name="GroundShadowShade">
          <GradientStop colorValue="382E241A" position="0"/>
          <GradientStop colorValue="002E241A" position="1"/>
        </RadialGradient>
      </Fill>
    </Shape>

    <!-- Warm beige studio backdrop, quiet and uncluttered. -->
    <Shape x="250" y="250" name="background">
      <Rectangle width="500" height="500" name="Path"/>
      <Fill name="Fill">
        <LinearGradient startX="-250" startY="-250" endX="250" endY="250" name="BackgroundShade">
          <GradientStop colorValue="FFFDF8F2" position="0"/>
          <GradientStop colorValue="FFF3ECE0" position="0.66"/>
          <GradientStop colorValue="FFE6D9C8" position="1"/>
        </LinearGradient>
      </Fill>
    </Shape>

    <StateMachine name="MiaomiaoV3StateMachine" id="0:900">
      <StateMachineNumber name="lookX" value="50" id="0:901"/>
      <StateMachineNumber name="lookY" value="50" id="0:902"/>
      <StateMachineBool name="isIdle" value="true" id="0:910"/>
      <StateMachineBool name="isFocused" id="0:911"/>
      <StateMachineTrigger name="blinkNow" id="0:920"/>
      <StateMachineTrigger name="earTwitchNow" id="0:921"/>

      <!-- Batch 1: 手指模式 (Finger Mode). touchZone: 0=head/cheek/back,
           1=belly, 2=tail -- app sets this before firing petTouchNow.
           intimacyLevel (0-100) decides belly flip vs dodge; app maintains
           it and sets it before firing. The 80/20 head enjoy/dodge split is
           native Rive random selection (see PetReaction layer below), not
           app-side dice-rolling. -->
      <StateMachineNumber name="touchZone" value="-1" id="0:922"/>
      <StateMachineNumber name="intimacyLevel" value="0" id="0:923"/>
      <StateMachineTrigger name="petTouchNow" id="0:924"/>

      <StateMachineLayer name="BaseIdle" id="0:930">
        <AnyState x="520" y="-100"/>
        <ExitState x="680" y="-100"/>
        <EntryState x="0" y="0"><StateTransition stateToId="0:931"/></EntryState>
        <AnimationState x="190" y="0" animationId="0:1000" id="0:931"/>
      </StateMachineLayer>

      <StateMachineLayer name="Blink" id="0:940">
        <AnyState x="520" y="-100">
          <StateTransition stateToId="0:942" duration="30">
            <TransitionTriggerCondition inputId="0:920"/>
          </StateTransition>
        </AnyState>
        <ExitState x="680" y="-100"/>
        <EntryState x="0" y="0"><StateTransition stateToId="0:941"/></EntryState>
        <AnimationState x="180" y="0" animationId="0:1001" id="0:941"/>
        <AnimationState x="380" y="0" reset="true" animationId="0:1002" id="0:942">
          <StateTransition stateToId="0:941" duration="40" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100"/>
        </AnimationState>
      </StateMachineLayer>

      <StateMachineLayer name="GazeX" id="0:950">
        <AnyState x="560" y="-100"/>
        <ExitState x="700" y="-100"/>
        <EntryState x="0" y="0"><StateTransition stateToId="0:951"/></EntryState>
        <BlendState1DInput x="210" y="0" inputId="0:901" id="0:951">
          <BlendAnimation1D animationId="0:1010" value="0"/>
          <BlendAnimation1D animationId="0:1011" value="50"/>
          <BlendAnimation1D animationId="0:1012" value="100"/>
        </BlendState1DInput>
      </StateMachineLayer>

      <StateMachineLayer name="GazeY" id="0:960">
        <AnyState x="560" y="-100"/>
        <ExitState x="700" y="-100"/>
        <EntryState x="0" y="0"><StateTransition stateToId="0:961"/></EntryState>
        <BlendState1DInput x="210" y="0" inputId="0:902" id="0:961">
          <BlendAnimation1D animationId="0:1013" value="0"/>
          <BlendAnimation1D animationId="0:1014" value="50"/>
          <BlendAnimation1D animationId="0:1015" value="100"/>
        </BlendState1DInput>
      </StateMachineLayer>

      <StateMachineLayer name="TailMotion" id="0:970">
        <AnyState x="520" y="-100"/>
        <ExitState x="680" y="-100"/>
        <EntryState x="0" y="0"><StateTransition stateToId="0:971"/></EntryState>
        <AnimationState x="190" y="0" animationId="0:1020" id="0:971"/>
      </StateMachineLayer>

      <StateMachineLayer name="EarMotion" id="0:980">
        <AnyState x="540" y="-100">
          <StateTransition stateToId="0:982" duration="25">
            <TransitionTriggerCondition inputId="0:921"/>
          </StateTransition>
        </AnyState>
        <ExitState x="700" y="-100"/>
        <EntryState x="0" y="0"><StateTransition stateToId="0:981"/></EntryState>
        <AnimationState x="180" y="0" animationId="0:1030" id="0:981"/>
        <AnimationState x="380" y="0" reset="true" animationId="0:1031" id="0:982">
          <StateTransition stateToId="0:981" duration="35" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100"/>
        </AnimationState>
      </StateMachineLayer>

      <!-- PetReaction (手指模式): all five outgoing transitions read
           touchZone/intimacyLevel + the petTouchNow trigger. HeadEnjoy and
           HeadDodge share the exact same condition (touchZone==0 AND
           trigger), so when both become eligible at once, AnyState's
           random="true" + each transition's randomWeight is what picks
           between them (80/20) -- this is native Rive random selection,
           not a dice roll the app pre-computes. Belly and tail outcomes are
           deterministic threshold checks instead. -->
      <StateMachineLayer name="PetReaction" id="0:990">
        <AnyState x="560" y="-260" random="true">
          <StateTransition stateToId="0:992" duration="20" randomWeight="80">
            <TransitionTriggerCondition inputId="0:924"/>
            <TransitionNumberCondition inputId="0:922" opValue="equal" value="0"/>
          </StateTransition>
          <StateTransition stateToId="0:993" duration="15" randomWeight="20">
            <TransitionTriggerCondition inputId="0:924"/>
            <TransitionNumberCondition inputId="0:922" opValue="equal" value="0"/>
          </StateTransition>
          <StateTransition stateToId="0:994" duration="20">
            <TransitionTriggerCondition inputId="0:924"/>
            <TransitionNumberCondition inputId="0:922" opValue="equal" value="1"/>
            <TransitionNumberCondition inputId="0:923" opValue="greaterThanOrEqual" value="50"/>
          </StateTransition>
          <StateTransition stateToId="0:995" duration="15">
            <TransitionTriggerCondition inputId="0:924"/>
            <TransitionNumberCondition inputId="0:922" opValue="equal" value="1"/>
            <TransitionNumberCondition inputId="0:923" opValue="lessThan" value="50"/>
          </StateTransition>
          <StateTransition stateToId="0:996" duration="15">
            <TransitionTriggerCondition inputId="0:924"/>
            <TransitionNumberCondition inputId="0:922" opValue="equal" value="2"/>
          </StateTransition>
        </AnyState>
        <ExitState x="760" y="-260"/>
        <EntryState x="0" y="0"><StateTransition stateToId="0:991"/></EntryState>
        <AnimationState x="180" y="-260" animationId="0:1099" id="0:991"/>
        <AnimationState x="380" y="-360" reset="true" animationId="0:1100" id="0:992">
          <StateTransition stateToId="0:991" duration="30" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100"/>
        </AnimationState>
        <AnimationState x="380" y="-300" reset="true" animationId="0:1101" id="0:993">
          <StateTransition stateToId="0:991" duration="20" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100"/>
        </AnimationState>
        <AnimationState x="380" y="-240" reset="true" animationId="0:1102" id="0:994">
          <StateTransition stateToId="0:991" duration="30" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100"/>
        </AnimationState>
        <AnimationState x="380" y="-180" reset="true" animationId="0:1103" id="0:995">
          <StateTransition stateToId="0:991" duration="20" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100"/>
        </AnimationState>
        <AnimationState x="380" y="-120" reset="true" animationId="0:1104" id="0:996">
          <StateTransition stateToId="0:991" duration="20" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100"/>
        </AnimationState>
      </StateMachineLayer>
    </StateMachine>

    <!-- Idle breathing: only body scale, intentionally restrained. -->
    <LinearAnimation loopValue="pingPong" fps="60" duration="120" name="Idle" id="0:1000">
      <KeyedObject objectId="0:200"><KeyedProperty propertyKey="17">
        <KeyFrameDouble value="0.992" frame="0" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
        <KeyFrameDouble value="1.014" frame="120" interpolationType="linear"/>
      </KeyedProperty></KeyedObject>
    </LinearAnimation>

    <!-- Long auto blink with a natural pause; triggerable blink is separate. -->
    <LinearAnimation loopValue="loop" fps="60" duration="250" name="AutoBlink" id="0:1001">
      <KeyedObject objectId="0:110"><KeyedProperty propertyKey="17">
        <KeyFrameDouble value="1" frame="0" interpolationType="linear"/>
        <KeyFrameDouble value="1" frame="178" interpolationType="cubic"><CubicEaseInterpolator x1="0.2" y1="0" x2="0.2" y2="1"/></KeyFrameDouble>
