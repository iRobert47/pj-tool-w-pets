            <GradientStop colorValue="FF191918" position="0.45"/>
            <GradientStop colorValue="FF101010" position="0.8"/>
            <GradientStop colorValue="FF090909" position="1"/>
          </RadialGradient>
        </Fill>
      </Shape>
    </Node>

    <!-- Tail: closed tapered Bezier shape (root->mid->tip), not a stroke.
         Root sits behind the torso (later sibling = further back). Vertices
         are perpendicular-offset from the original S-curve centerline at
         decreasing half-widths (15 -> 10 -> 6 -> a single tapered tip). -->
    <Shape x="303" y="385" rotation="-0.08" name="tail_main" id="0:240">
      <PointsPath isClosed="true" name="Path">
        <CubicMirroredVertex x="18" y="52" rotation="-0.59" distance="11"/>
