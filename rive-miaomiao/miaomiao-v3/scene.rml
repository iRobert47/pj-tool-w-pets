      </Node>

      <Shape x="1" y="35" name="nose">
        <PointsPath isClosed="true" name="Path">
          <CubicMirroredVertex x="-6" y="-2" rotation="0" distance="3"/>
          <CubicMirroredVertex x="6" y="-2" rotation="0" distance="3"/>
          <CubicMirroredVertex x="0" y="5" rotation="1.5708" distance="3"/>
        </PointsPath>
        <Fill name="Fill"><SolidColor colorValue="FF8E7B70" name="Color"/></Fill>
      </Shape>

      <!-- Head_Light: large, low-contrast, feathered warm wash over the
           forehead/upper cheeks. Not a highlight graphic -- reads as volume. -->
      <Shape x="0" y="-20" name="head_light">
        <Ellipse width="112" height="66" name="Path"/>
        <Fill name="Fill">
          <RadialGradient startX="-4" startY="-8" endX="48" endY="26" name="HeadLight">
            <GradientStop colorValue="24F5F0E6" position="0"/>
            <GradientStop colorValue="10F5F0E6" position="0.55"/>
            <GradientStop colorValue="00F5F0E6" position="1"/>
          </RadialGradient>
        </Fill>
      </Shape>

      <!-- LowerFace_Shadow: soft dark wash under the cheeks/jaw for the same
           feathered, geometry-following treatment as Head_Light. -->
      <Shape x="2" y="38" name="lowerface_shadow">
        <Ellipse width="98" height="48" name="Path"/>
        <Fill name="Fill">
          <RadialGradient startX="0" startY="-4" endX="42" endY="18" name="LowerFaceShadow">
            <GradientStop colorValue="1E050403" position="0"/>
            <GradientStop colorValue="00050403" position="1"/>
          </RadialGradient>
        </Fill>
      </Shape>

      <!-- Head_Base: organic closed silhouette, 8 anchors, generous bezier
           handles so no facet reads as a corner at any zoom. Slightly
           asymmetric on purpose (not a mirrored pair) -- forehead valley,
           ear-root shoulders, cheek-widest, jaw, chin. -->
      <Shape name="head_main" id="0:101">
        <PointsPath isClosed="true" name="Path">
          <CubicMirroredVertex x="2" y="-60" rotation="0" distance="27"/>
          <CubicMirroredVertex x="74" y="-45" rotation="1.05" distance="37"/>
