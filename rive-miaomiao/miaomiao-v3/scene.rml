<Rive version="1" kind="fragment">
  <Artboard defaultStateMachineId="0:900" width="500" height="500" styleId="0:5" name="MiaomiaoV3" id="0:2">
    <LayoutComponentStyle name="Artboard Style" id="0:5"/>

    <!-- PHASE 2 GEOMETRY PASS. All positions/sizes are derived by converting
         the Phase-1 reference-photo pixel measurements (canvas ~1280) into
         this artboard's 500-unit space at a fixed scale (S=0.3926), so the
         cat now occupies ~64% of canvas height matching the reference
         instead of floating small in empty margin. Eyes and the cushion
         concept are unchanged; head/ears/body/tail are rebuilt at the new
         scale. Body_main's own silhouette carries a shallow integrated
         notch at the bottom for leg separation -- no separate leg shapes.
         Earlier siblings paint above later siblings. -->

    <!-- Cushion_Front: thickened (bottom edge pulled down further) for a
         plush, voluminous rim instead of a thin platter edge. Single soft
         dip, not a wavy hammock. Painted first (=frontmost) so it overlaps
         the cat's lower body/paws -- the "sinking in" cue.
         Cushion_Back/Inner_Depression stay behind the cat further down. -->
    <Shape x="250" y="348" name="cushion_front">
      <PointsPath isClosed="true" name="Path">
        <CubicMirroredVertex x="-193" y="-20" rotation="-0.42" distance="58"/>
        <CubicMirroredVertex x="0" y="22" rotation="0" distance="64"/>
        <CubicMirroredVertex x="193" y="-20" rotation="0.42" distance="58"/>
        <CubicMirroredVertex x="150" y="64" rotation="2.55" distance="62"/>
        <CubicMirroredVertex x="-150" y="64" rotation="-2.55" distance="62"/>
      </PointsPath>
      <Fill name="Fill">
        <LinearGradient startX="0" startY="-20" endX="0" endY="64" name="CushionFrontShade">
          <GradientStop colorValue="FFF7F1E6" position="0"/>
          <GradientStop colorValue="FFE8DAC5" position="0.6"/>
          <GradientStop colorValue="FFDBC9AE" position="1"/>
        </LinearGradient>
      </Fill>
    </Shape>

    <!-- Head rig: eye system UNCHANGED. Repositioned so eyes land at the
         reference-calibrated absolute position (~251,137). -->
    <Node x="250" y="136" name="head_rig" id="0:100">
      <Node x="-32" y="2" name="eye_left_rig" id="0:110">
