<Rive version="1" kind="fragment">
  <Artboard defaultStateMachineId="0:900" width="500" height="500" styleId="0:5" name="MiaomiaoV3" id="0:2">
    <LayoutComponentStyle name="Artboard Style" id="0:5"/>

    <!-- V3 illustrated rig. Earlier siblings paint above later siblings. -->

    <!-- Head rig: expressive eyes over one continuous illustrated head silhouette. -->
    <Node x="250" y="214" name="head_rig" id="0:100">
      <Node x="-34" y="2" name="eye_left_rig" id="0:110">
        <Shape x="0" y="1" name="pupil_left" id="0:120">
          <Ellipse width="13" height="22" name="Path"/>
          <Fill name="Fill"><SolidColor colorValue="FF101112" name="Color"/></Fill>
        </Shape>
        <Shape name="eye_left_white">
          <Ellipse width="42" height="39" name="Path"/>
          <Fill name="Fill"><SolidColor colorValue="FFFAF3E6" name="Color"/></Fill>
        </Shape>
      </Node>

      <Node x="34" y="1" name="eye_right_rig" id="0:111">
        <Shape x="0" y="1" name="pupil_right" id="0:121">
          <Ellipse width="13" height="22" name="Path"/>
          <Fill name="Fill"><SolidColor colorValue="FF101112" name="Color"/></Fill>
