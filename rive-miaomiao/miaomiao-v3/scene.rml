      <!-- Head_Base: wider fuller cheeks with a lower-mid-face fill term
           (river-stone, not a single round bulge), flatter wider top,
           gentler broader jaw taper, continuous chin. 12 vertices placed at
           the actual bump-peak angles (a previous 8-point even-spacing pass
           straddled the peaks and also had a left/right mirror-angle bug
           in the cheek formula -- fixed here, verified symmetric). -->
      <Shape name="head_main" id="0:101">
        <PointsPath isClosed="true" name="Path">
          <CubicMirroredVertex x="0" y="-61" rotation="0" distance="18"/>
          <CubicMirroredVertex x="52" y="-59" rotation="0.33" distance="15"/>
          <CubicMirroredVertex x="78" y="-43" rotation="0.73" distance="11"/>
