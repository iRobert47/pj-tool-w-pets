        </PointsPath>
        <Fill name="Fill">
          <RadialGradient startX="-6" startY="-38" endX="58" endY="48" name="FurShade">
            <GradientStop colorValue="FF292827" position="0"/>
            <GradientStop colorValue="FF191918" position="0.45"/>
            <GradientStop colorValue="FF101010" position="0.8"/>
            <GradientStop colorValue="FF090909" position="1"/>
          </RadialGradient>
        </Fill>
      </Shape>

      <!-- Ear_Back: triangular with a softly rounded tip (bigger tip handle),
           base pulled down/inward so it tucks under head_main's shoulders --
           verified gap-free through the twitch/ambient rotation range.
           Left/right share one locally-symmetric vertex pattern (translating
           the origin mirrors it correctly); origin/rotation differ slightly
           on purpose to avoid perfect bilateral symmetry. -->
      <Shape x="-48" y="-61" rotation="-0.12" name="ear_left" id="0:103">
        <PointsPath isClosed="true" name="Path">
          <CubicMirroredVertex x="-18" y="8" rotation="-1.10" distance="13"/>
