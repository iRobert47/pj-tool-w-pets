    <LinearAnimation duration="1" name="LookDown" id="0:1015">
      <KeyedObject objectId="0:120"><KeyedProperty propertyKey="14"><KeyFrameDouble value="6" frame="0" interpolationType="linear"/></KeyedProperty></KeyedObject>
      <KeyedObject objectId="0:121"><KeyedProperty propertyKey="14"><KeyFrameDouble value="6" frame="0" interpolationType="linear"/></KeyedProperty></KeyedObject>
      <KeyedObject objectId="0:100"><KeyedProperty propertyKey="14"><KeyFrameDouble value="139" frame="0" interpolationType="linear"/></KeyedProperty></KeyedObject>
    </LinearAnimation>

    <!-- Tail moves independently from breathing. -->
    <LinearAnimation loopValue="pingPong" fps="60" duration="150" name="TailSway" id="0:1020">
      <KeyedObject objectId="0:240"><KeyedProperty propertyKey="15">
        <KeyFrameDouble value="-0.12" frame="0" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
        <KeyFrameDouble value="0.14" frame="150" interpolationType="linear"/>
      </KeyedProperty></KeyedObject>
    </LinearAnimation>

    <!-- Ear ambient motion stays tiny; trigger creates one sharper twitch. -->
    <LinearAnimation loopValue="loop" fps="60" duration="360" name="EarAmbient" id="0:1030">
      <KeyedObject objectId="0:103"><KeyedProperty propertyKey="15">
        <KeyFrameDouble value="-0.12" frame="0" interpolationType="linear"/>
        <KeyFrameDouble value="-0.12" frame="250" interpolationType="cubic"><CubicEaseInterpolator x1="0.2" y1="0" x2="0.2" y2="1"/></KeyFrameDouble>
        <KeyFrameDouble value="-0.24" frame="258" interpolationType="hold"/>
        <KeyFrameDouble value="-0.10" frame="269" interpolationType="cubic"><CubicEaseInterpolator x1="0.3" y1="0" x2="0.5" y2="1"/></KeyFrameDouble>
        <KeyFrameDouble value="-0.12" frame="285" interpolationType="linear"/>
        <KeyFrameDouble value="-0.12" frame="360" interpolationType="linear"/>
      </KeyedProperty></KeyedObject>
    </LinearAnimation>

    <LinearAnimation fps="60" duration="24" name="EarTwitchNow" id="0:1031">
      <KeyedObject objectId="0:105"><KeyedProperty propertyKey="15">
        <KeyFrameDouble value="0.12" frame="0" interpolationType="cubic"><CubicEaseInterpolator x1="0.1" y1="0" x2="0.2" y2="1"/></KeyFrameDouble>
        <KeyFrameDouble value="0.28" frame="7" interpolationType="hold"/>
        <KeyFrameDouble value="0.05" frame="14" interpolationType="cubic"><CubicEaseInterpolator x1="0.2" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
        <KeyFrameDouble value="0.12" frame="24" interpolationType="linear"/>
      </KeyedProperty></KeyedObject>
    </LinearAnimation>

    <!-- Batch 1 (手指模式) reaction poses. These route through body_rig's
         rotation(15)/scaleX(16), which no other layer keys, so PetReaction
         (last layer in the machine) can freely override them and hand back
         to silence (PetRest keys nothing) without fighting Idle's breathing
         (scaleY) or Gaze's head_rig x/y. TailDodge is the one exception --
         it targets tail_main directly since a tail-touch reaction is
         naturally a tail motion; its end value (0.01) sits mid-way inside
         TailSway's -0.12..0.14 range to keep the hand-back pop small. -->
    <LinearAnimation fps="60" duration="1" name="PetRest" id="0:1099">
      <KeyedObject objectId="0:200"><KeyedProperty propertyKey="15">
        <KeyFrameDouble value="0" frame="0" interpolationType="linear"/>
      </KeyedProperty></KeyedObject>
    </LinearAnimation>

    <!-- Head/cheek/back pet, happy outcome (80% via randomWeight on the
         AnyState transition): lean into the touch, slight contented puff. -->
    <LinearAnimation fps="60" duration="45" name="HeadEnjoy" id="0:1100">
      <KeyedObject objectId="0:200">
        <KeyedProperty propertyKey="15">
          <KeyFrameDouble value="0" frame="0" interpolationType="cubic"><CubicEaseInterpolator x1="0.2" y1="0" x2="0.2" y2="1"/></KeyFrameDouble>
          <KeyFrameDouble value="-0.07" frame="12" interpolationType="cubic"><CubicEaseInterpolator x1="0.3" y1="0" x2="0.3" y2="1"/></KeyFrameDouble>
          <KeyFrameDouble value="-0.06" frame="30" interpolationType="cubic"><CubicEaseInterpolator x1="0.3" y1="0" x2="0.5" y2="1"/></KeyFrameDouble>
          <KeyFrameDouble value="0" frame="45" interpolationType="linear"/>
        </KeyedProperty>
        <KeyedProperty propertyKey="16">
          <KeyFrameDouble value="1" frame="0" interpolationType="cubic"><CubicEaseInterpolator x1="0.2" y1="0" x2="0.2" y2="1"/></KeyFrameDouble>
          <KeyFrameDouble value="1.03" frame="12" interpolationType="cubic"><CubicEaseInterpolator x1="0.3" y1="0" x2="0.3" y2="1"/></KeyFrameDouble>
          <KeyFrameDouble value="1.025" frame="30" interpolationType="cubic"><CubicEaseInterpolator x1="0.3" y1="0" x2="0.5" y2="1"/></KeyFrameDouble>
          <KeyFrameDouble value="1" frame="45" interpolationType="linear"/>
        </KeyedProperty>
      </KeyedObject>
    </LinearAnimation>

    <!-- Head/cheek/back pet, dodge outcome (remaining 20%): quick flinch
         away and back, no puff. -->
    <LinearAnimation fps="60" duration="20" name="HeadDodge" id="0:1101">
      <KeyedObject objectId="0:200"><KeyedProperty propertyKey="15">
        <KeyFrameDouble value="0" frame="0" interpolationType="cubic"><CubicEaseInterpolator x1="0.1" y1="0" x2="0.2" y2="1"/></KeyFrameDouble>
        <KeyFrameDouble value="0.09" frame="6" interpolationType="hold"/>
        <KeyFrameDouble value="0" frame="20" interpolationType="cubic"><CubicEaseInterpolator x1="0.2" y1="0" x2="0.5" y2="1"/></KeyFrameDouble>
      </KeyedProperty></KeyedObject>
    </LinearAnimation>

    <!-- Belly touch, high-intimacy outcome: a playful wobble-roll approximating
         a belly-up reaction (the rig has no true belly-up pose/geometry yet). -->
    <LinearAnimation fps="60" duration="50" name="BellyFlip" id="0:1102">
      <KeyedObject objectId="0:200">
        <KeyedProperty propertyKey="15">
          <KeyFrameDouble value="0" frame="0" interpolationType="cubic"><CubicEaseInterpolator x1="0.3" y1="0" x2="0.3" y2="1"/></KeyFrameDouble>
          <KeyFrameDouble value="0.10" frame="14" interpolationType="cubic"><CubicEaseInterpolator x1="0.3" y1="0" x2="0.3" y2="1"/></KeyFrameDouble>
          <KeyFrameDouble value="-0.08" frame="30" interpolationType="cubic"><CubicEaseInterpolator x1="0.3" y1="0" x2="0.3" y2="1"/></KeyFrameDouble>
          <KeyFrameDouble value="0" frame="50" interpolationType="cubic"><CubicEaseInterpolator x1="0.3" y1="0" x2="0.5" y2="1"/></KeyFrameDouble>
        </KeyedProperty>
        <KeyedProperty propertyKey="16">
          <KeyFrameDouble value="1" frame="0" interpolationType="cubic"><CubicEaseInterpolator x1="0.3" y1="0" x2="0.3" y2="1"/></KeyFrameDouble>
          <KeyFrameDouble value="0.93" frame="14" interpolationType="cubic"><CubicEaseInterpolator x1="0.3" y1="0" x2="0.3" y2="1"/></KeyFrameDouble>
          <KeyFrameDouble value="1.06" frame="30" interpolationType="cubic"><CubicEaseInterpolator x1="0.3" y1="0" x2="0.3" y2="1"/></KeyFrameDouble>
          <KeyFrameDouble value="1" frame="50" interpolationType="cubic"><CubicEaseInterpolator x1="0.3" y1="0" x2="0.5" y2="1"/></KeyFrameDouble>
        </KeyedProperty>
      </KeyedObject>
    </LinearAnimation>

    <!-- Belly touch, low-intimacy outcome: quick pull-away flinch. -->
    <LinearAnimation fps="60" duration="18" name="BellyDodge" id="0:1103">
      <KeyedObject objectId="0:200">
        <KeyedProperty propertyKey="15">
          <KeyFrameDouble value="0" frame="0" interpolationType="cubic"><CubicEaseInterpolator x1="0.1" y1="0" x2="0.2" y2="1"/></KeyFrameDouble>
          <KeyFrameDouble value="-0.06" frame="6" interpolationType="hold"/>
          <KeyFrameDouble value="0" frame="18" interpolationType="cubic"><CubicEaseInterpolator x1="0.2" y1="0" x2="0.5" y2="1"/></KeyFrameDouble>
        </KeyedProperty>
        <KeyedProperty propertyKey="16">
          <KeyFrameDouble value="1" frame="0" interpolationType="cubic"><CubicEaseInterpolator x1="0.1" y1="0" x2="0.2" y2="1"/></KeyFrameDouble>
          <KeyFrameDouble value="0.97" frame="6" interpolationType="hold"/>
          <KeyFrameDouble value="1" frame="18" interpolationType="cubic"><CubicEaseInterpolator x1="0.2" y1="0" x2="0.5" y2="1"/></KeyFrameDouble>
        </KeyedProperty>
      </KeyedObject>
    </LinearAnimation>

    <!-- Tail touch: a quick whip-away, ending near TailSway's own mid-range
         so the hand-back to that layer's continuously-running value doesn't
         pop far. -->
    <LinearAnimation fps="60" duration="20" name="TailDodge" id="0:1104">
      <KeyedObject objectId="0:240"><KeyedProperty propertyKey="15">
        <KeyFrameDouble value="0.01" frame="0" interpolationType="cubic"><CubicEaseInterpolator x1="0.1" y1="0" x2="0.2" y2="1"/></KeyFrameDouble>
        <KeyFrameDouble value="-0.32" frame="7" interpolationType="hold"/>
        <KeyFrameDouble value="0.01" frame="20" interpolationType="cubic"><CubicEaseInterpolator x1="0.2" y1="0" x2="0.5" y2="1"/></KeyFrameDouble>
      </KeyedProperty></KeyedObject>
    </LinearAnimation>
  </Artboard>
</Rive>
