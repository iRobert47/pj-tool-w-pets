        <KeyFrameDouble value="1" frame="191" interpolationType="cubic"><CubicEaseInterpolator x1="0.3" y1="0" x2="0.5" y2="1"/></KeyFrameDouble>
        <KeyFrameDouble value="1" frame="250" interpolationType="linear"/>
      </KeyedProperty></KeyedObject>
      <KeyedObject objectId="0:111"><KeyedProperty propertyKey="17">
        <KeyFrameDouble value="1" frame="0" interpolationType="linear"/>
        <KeyFrameDouble value="1" frame="178" interpolationType="cubic"><CubicEaseInterpolator x1="0.2" y1="0" x2="0.2" y2="1"/></KeyFrameDouble>
        <KeyFrameDouble value="0.09" frame="184" interpolationType="hold"/>
        <KeyFrameDouble value="1" frame="191" interpolationType="cubic"><CubicEaseInterpolator x1="0.3" y1="0" x2="0.5" y2="1"/></KeyFrameDouble>
        <KeyFrameDouble value="1" frame="250" interpolationType="linear"/>
      </KeyedProperty></KeyedObject>
    </LinearAnimation>

    <LinearAnimation fps="60" duration="18" name="BlinkNow" id="0:1002">
      <KeyedObject objectId="0:110"><KeyedProperty propertyKey="17">
        <KeyFrameDouble value="1" frame="0" interpolationType="cubic"><CubicEaseInterpolator x1="0.2" y1="0" x2="0.2" y2="1"/></KeyFrameDouble>
        <KeyFrameDouble value="0.07" frame="7" interpolationType="hold"/>
        <KeyFrameDouble value="1" frame="18" interpolationType="linear"/>
      </KeyedProperty></KeyedObject>
      <KeyedObject objectId="0:111"><KeyedProperty propertyKey="17">
        <KeyFrameDouble value="1" frame="0" interpolationType="cubic"><CubicEaseInterpolator x1="0.2" y1="0" x2="0.2" y2="1"/></KeyFrameDouble>
        <KeyFrameDouble value="0.07" frame="7" interpolationType="hold"/>
        <KeyFrameDouble value="1" frame="18" interpolationType="linear"/>
      </KeyedProperty></KeyedObject>
    </LinearAnimation>

    <!-- Horizontal look poses: pupils lead, head follows only a few pixels. -->
    <LinearAnimation duration="1" name="LookLeft" id="0:1010">
      <KeyedObject objectId="0:120"><KeyedProperty propertyKey="13"><KeyFrameDouble value="-7" frame="0" interpolationType="linear"/></KeyedProperty></KeyedObject>
      <KeyedObject objectId="0:121"><KeyedProperty propertyKey="13"><KeyFrameDouble value="-7" frame="0" interpolationType="linear"/></KeyedProperty></KeyedObject>
      <KeyedObject objectId="0:100"><KeyedProperty propertyKey="13"><KeyFrameDouble value="246" frame="0" interpolationType="linear"/></KeyedProperty></KeyedObject>
