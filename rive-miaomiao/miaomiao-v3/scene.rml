    </LinearAnimation>

    <!-- Tail moves independently from breathing. -->
    <LinearAnimation loopValue="pingPong" fps="60" duration="150" name="TailSway" id="0:1020">
      <KeyedObject objectId="0:240"><KeyedProperty propertyKey="15">
        <KeyFrameDouble value="-0.12" frame="0" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
        <KeyFrameDouble value="0.14" frame="150" interpolationType="linear"/>
      </KeyedProperty></KeyedObject>
    </LinearAnimation>

    <!-- Ear ambient motion stays tiny; trigger creates one sharper twitch. -->
    <LinearAnimation loopValue="loop" fps="60" duration="360" name="EarAmbient" id="0:1030">
      <KeyedObject objectId="0:103"><KeyedProperty propertyKey="15">
        <KeyFrameDouble value="-0.12" frame="0" interpolationType="linear"/>
        <KeyFrameDouble value="-0.12" frame="250" interpolationType="cubic"><CubicEaseInterpolator x1="0.2" y1="0" x2="0.2" y2="1"/></KeyFrameDouble>
