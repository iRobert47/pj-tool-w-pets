      <KeyedObject objectId="0:121"><KeyedProperty propertyKey="13"><KeyFrameDouble value="7" frame="0" interpolationType="linear"/></KeyedProperty></KeyedObject>
      <KeyedObject objectId="0:100"><KeyedProperty propertyKey="13"><KeyFrameDouble value="254" frame="0" interpolationType="linear"/></KeyedProperty></KeyedObject>
    </LinearAnimation>

    <LinearAnimation duration="1" name="LookUp" id="0:1013">
      <KeyedObject objectId="0:120"><KeyedProperty propertyKey="14"><KeyFrameDouble value="-5" frame="0" interpolationType="linear"/></KeyedProperty></KeyedObject>
      <KeyedObject objectId="0:121"><KeyedProperty propertyKey="14"><KeyFrameDouble value="-5" frame="0" interpolationType="linear"/></KeyedProperty></KeyedObject>
