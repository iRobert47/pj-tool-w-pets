<Rive version="1" kind="fragment">
  <Artboard defaultStateMachineId="0:900" width="500" height="500" styleId="0:5" name="MiaomiaoV3" id="0:2">
    <LayoutComponentStyle name="Artboard Style" id="0:5"/>

    <!-- V4 reconstruction: organic silhouette, feathered volumetric shading,
         warm ivory eyes, palette-based fur tones, cat sinks into a real
         cushion. Earlier siblings paint above later siblings. -->

    <!-- Cushion front rim: a hammock-shaped dip, not a flat dome -- the top
         edge sinks lowest where the cat's weight would press (center) and
         rises on both sides, so the paws/lower body read as pressed into
         soft fabric instead of cut off by a hard straight edge. -->
    <Shape x="250" y="418" name="cushion_front">
      <PointsPath isClosed="true" name="Path">
        <CubicMirroredVertex x="-132" y="-22" rotation="-0.30" distance="34"/>
        <CubicMirroredVertex x="-64" y="8" rotation="-0.65" distance="26"/>
        <CubicMirroredVertex x="0" y="20" rotation="0" distance="30"/>
        <CubicMirroredVertex x="64" y="6" rotation="0.68" distance="26"/>
        <CubicMirroredVertex x="134" y="-24" rotation="0.32" distance="34"/>
        <CubicMirroredVertex x="96" y="34" rotation="2.55" distance="42"/>
        <CubicMirroredVertex x="-94" y="34" rotation="-2.55" distance="42"/>
      </PointsPath>
      <Fill name="Fill">
        <LinearGradient startX="-120" startY="-10" endX="110" endY="30" name="CushionFront">
          <GradientStop colorValue="FFF6F1E9" position="0"/>
          <GradientStop colorValue="FFE6DACB" position="0.6"/>
          <GradientStop colorValue="FFD6C6B2" position="1"/>
        </LinearGradient>
      </Fill>
    </Shape>

    <!-- Head rig: expressive eyes over one continuous organic head silhouette. -->
    <Node x="250" y="214" name="head_rig" id="0:100">
      <Node x="-32" y="2" name="eye_left_rig" id="0:110">
        <Shape x="0" y="1" name="pupil_left" id="0:120">
          <Ellipse width="16" height="30" name="Path"/>
          <Fill name="Fill"><SolidColor colorValue="FF111111" name="Color"/></Fill>
        </Shape>
        <Shape name="eye_left_white">
          <Ellipse width="38" height="48" name="Path"/>
          <Fill name="Fill"><SolidColor colorValue="FFF7F3E8" name="Color"/></Fill>
        </Shape>
      </Node>

      <Node x="33" y="1" name="eye_right_rig" id="0:111">
