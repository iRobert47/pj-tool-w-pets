            <GradientStop colorValue="FF101010" position="0.6"/>
            <GradientStop colorValue="FF090909" position="1"/>
          </RadialGradient>
        </Fill>
      </Shape>
    </Node>

    <!-- Body rig: shoulder/chest/belly/hip suggested through silhouette width
         changes and feathered shading, not a uniform ellipse. -->
    <Node x="250" y="350" name="body_rig" id="0:200">
      <!-- Chest_Light: large, low-contrast, feathered -- same treatment as
