        <Shape name="eye_right_white">
          <Ellipse width="42" height="39" name="Path"/>
          <Fill name="Fill"><SolidColor colorValue="FFFAF3E6" name="Color"/></Fill>
        </Shape>
      </Node>

      <Shape x="0" y="34" name="nose">
        <PointsPath isClosed="true" name="Path">
          <CubicMirroredVertex x="-6" y="-2" rotation="0" distance="3"/>
          <CubicMirroredVertex x="6" y="-2" rotation="0" distance="3"/>
          <CubicMirroredVertex x="0" y="5" rotation="1.5708" distance="3"/>
        </PointsPath>
        <Fill name="Fill"><SolidColor colorValue="FF8E7B70" name="Color"/></Fill>
      </Shape>

      <!-- Head is a custom continuous bezier silhouette, not a primitive ellipse.
           Shoulders (V2/V8) are raised and widened so the fill already covers
           the ear roots before the ear shapes are drawn, killing the gap. -->
      <Shape name="head_main" id="0:101">
        <PointsPath isClosed="true" name="Path">
          <CubicMirroredVertex x="0" y="-59" rotation="0" distance="22"/>
          <CubicMirroredVertex x="53" y="-57" rotation="0.86" distance="34"/>
          <CubicMirroredVertex x="79" y="-3" rotation="1.46" distance="28"/>
          <CubicMirroredVertex x="62" y="43" rotation="2.18" distance="28"/>
          <CubicMirroredVertex x="8" y="64" rotation="3.02" distance="34"/>
          <CubicMirroredVertex x="-57" y="48" rotation="-2.30" distance="31"/>
          <CubicMirroredVertex x="-81" y="0" rotation="-1.55" distance="29"/>
          <CubicMirroredVertex x="-54" y="-57" rotation="-0.86" distance="34"/>
        </PointsPath>
        <Fill name="Fill">
          <LinearGradient startX="-60" startY="-60" endX="68" endY="65" name="FurShade">
            <GradientStop colorValue="FF2A2B2C" position="0"/>
            <GradientStop colorValue="FF151617" position="0.55"/>
            <GradientStop colorValue="FF0F1011" position="1"/>
          </LinearGradient>
        </Fill>
      </Shape>

      <!-- Ears sit behind head, roots pulled down/inward so they tuck under the
           raised head shoulders above instead of floating above a gap. Base
           notch (last vertex) is shallower than before to soften the inner cut. -->
      <Shape x="-43" y="-48" rotation="-0.12" name="ear_left" id="0:103">
        <PointsPath isClosed="true" name="Path">
          <CubicMirroredVertex x="-22" y="20" rotation="-1.12" distance="12"/>
          <CubicMirroredVertex x="-3" y="-49" rotation="-0.30" distance="15"/>
          <CubicMirroredVertex x="22" y="22" rotation="1.12" distance="13"/>
          <CubicMirroredVertex x="0" y="10" rotation="3.1" distance="9"/>
        </PointsPath>
        <Fill name="Fill">
          <LinearGradient startX="-10" startY="-45" endX="18" endY="20" name="EarShade">
            <GradientStop colorValue="FF343335" position="0"/>
            <GradientStop colorValue="FF111213" position="1"/>
          </LinearGradient>
        </Fill>
      </Shape>
      <Shape x="43" y="-48" rotation="0.12" name="ear_right" id="0:105">
        <PointsPath isClosed="true" name="Path">
          <CubicMirroredVertex x="-22" y="22" rotation="-1.12" distance="13"/>
          <CubicMirroredVertex x="3" y="-49" rotation="0.30" distance="15"/>
          <CubicMirroredVertex x="22" y="20" rotation="1.12" distance="12"/>
          <CubicMirroredVertex x="0" y="10" rotation="3.1" distance="9"/>
