    <!-- Body rig: compact-but-vertically-substantial seated torso. Widest
         point approaches head width. Bottom carries a shallow integrated
         notch (lowest ~8% of body height) for leg separation -- no
         separate dangling leg shapes. -->
    <Node x="250" y="236" name="body_rig" id="0:200">
      <!-- Internal front-leg/paw forms: real (small) closed shapes layered
           INSIDE body_main's unchanged silhouette, not a silhouette trick.
           Painted before body_main so they sit on top of its fill but
           stay contained well within its boundary -- verified by render,
           no part of them crosses the outer edge. Flat, subtle tones only
           (no outlines, no gradients here) so they read as a value shift,
           not a drawn shape. front_leg_* are short/narrow and stop well
           short of the body's own bottom edge; paw_* sit lower, near the
           existing notch/paw-bump vertices, and get progressively covered
           by cushion_front (painted frontmost) as they approach it --
           that's the "disappear behind the cushion rim" cue, done via
           existing z-order rather than new logic. -->
      <Shape x="-18" y="88" name="front_leg_L">
        <PointsPath isClosed="true" name="Path">
          <CubicMirroredVertex x="0" y="-20" rotation="0" distance="5"/>
          <CubicMirroredVertex x="6" y="0" rotation="1.5708" distance="18"/>
          <CubicMirroredVertex x="0" y="20" rotation="3.1416" distance="5"/>
          <CubicMirroredVertex x="-6" y="0" rotation="-1.5708" distance="18"/>
        </PointsPath>
        <Fill name="Fill">
          <RadialGradient startX="0" startY="0" endX="6" endY="20" name="LegShade">
            <GradientStop colorValue="80000000" position="0"/>
            <GradientStop colorValue="00000000" position="1"/>
          </RadialGradient>
        </Fill>
      </Shape>
      <Shape x="18" y="88" name="front_leg_R">
        <PointsPath isClosed="true" name="Path">
          <CubicMirroredVertex x="0" y="-20" rotation="0" distance="5"/>
          <CubicMirroredVertex x="6" y="0" rotation="1.5708" distance="18"/>
          <CubicMirroredVertex x="0" y="20" rotation="3.1416" distance="5"/>
          <CubicMirroredVertex x="-6" y="0" rotation="-1.5708" distance="18"/>
        </PointsPath>
        <Fill name="Fill">
          <RadialGradient startX="0" startY="0" endX="6" endY="20" name="LegShade">
            <GradientStop colorValue="80000000" position="0"/>
            <GradientStop colorValue="00000000" position="1"/>
          </RadialGradient>
        </Fill>
      </Shape>
      <Shape x="-22" y="116" name="paw_L">
        <Ellipse width="22" height="15" name="Path"/>
        <Fill name="Fill">
          <RadialGradient startX="0" startY="0" endX="11" endY="4" name="PawShade">
            <GradientStop colorValue="90000000" position="0"/>
            <GradientStop colorValue="00000000" position="1"/>
          </RadialGradient>
        </Fill>
      </Shape>
      <Shape x="22" y="116" name="paw_R">
        <Ellipse width="22" height="15" name="Path"/>
        <Fill name="Fill">
          <RadialGradient startX="0" startY="0" endX="11" endY="4" name="PawShade">
            <GradientStop colorValue="90000000" position="0"/>
            <GradientStop colorValue="00000000" position="1"/>
          </RadialGradient>
        </Fill>
      </Shape>

      <!-- Torso_Base: unchanged above the hip. Bottom-3 vertices fixed --
           they previously had the paw/notch relationship backwards (the
           center point stuck out further than the flanking "paw" points,
           which is why no paw separation was visible; it just read as a
           smooth curve). Now the two outer points sit lower (paws resting
           down) and the center point is pulled up between them (shallow
           notch), only in the lowest ~6% of body height. -->
      <Shape name="body_main" id="0:201">
        <PointsPath isClosed="true" name="Path">
          <CubicMirroredVertex x="1" y="-93" rotation="0.07" distance="19"/>
          <CubicMirroredVertex x="56" y="-58" rotation="0.91" distance="16"/>
          <CubicMirroredVertex x="77" y="-16" rotation="1.31" distance="13"/>
          <CubicMirroredVertex x="86" y="28" rotation="1.55" distance="16"/>
          <CubicMirroredVertex x="69" y="94" rotation="2.09" distance="15"/>
          <CubicMirroredVertex x="38" y="128" rotation="2.82" distance="9"/>
          <CubicMirroredVertex x="1" y="117" rotation="3.14" distance="9"/>
          <CubicMirroredVertex x="-38" y="128" rotation="-2.82" distance="9"/>
          <CubicMirroredVertex x="-67" y="94" rotation="-2.09" distance="15"/>
          <CubicMirroredVertex x="-84" y="28" rotation="-1.55" distance="16"/>
          <CubicMirroredVertex x="-75" y="-16" rotation="-1.28" distance="13"/>
          <CubicMirroredVertex x="-59" y="-63" rotation="-1.00" distance="17"/>
        </PointsPath>
        <Fill name="Fill">
          <RadialGradient startX="0" startY="-45" endX="70" endY="100" name="BodyShade">
            <GradientStop colorValue="FF211F1B" position="0"/>
            <GradientStop colorValue="FF18161A" position="0.45"/>
            <GradientStop colorValue="FF120F0D" position="0.8"/>
            <GradientStop colorValue="FF0D0B0A" position="1"/>
          </RadialGradient>
        </Fill>
      </Shape>
    </Node>

    <!-- Tail: curl tightened (mid/tip pulled closer to the root => less
         inner negative space), scaled down further and root positioned to
         tuck more clearly under the hip. Still thick-rooted with a blunt
         rounded curl-end, closed shape not a stroke. Root sits behind the
         lower-right torso (drawn after body_rig => further back). -->
    <Shape x="318" y="304" rotation="-0.05" name="tail_main" id="0:240">
      <PointsPath isClosed="true" name="Path">
        <CubicMirroredVertex x="12" y="31" rotation="-0.28" distance="12"/>
        <CubicMirroredVertex x="54" y="-14" rotation="-1.37" distance="16"/>
        <CubicMirroredVertex x="34" y="-74" rotation="-2.07" distance="9"/>
        <CubicMirroredVertex x="22" y="-73" rotation="2.11" distance="4"/>
        <CubicMirroredVertex x="22" y="-54" rotation="1.57" distance="7"/>
        <CubicMirroredVertex x="22" y="-14" rotation="2.10" distance="10"/>
        <CubicMirroredVertex x="-12" y="5" rotation="1.79" distance="9"/>
      </PointsPath>
      <Fill name="Fill">
        <RadialGradient startX="15" startY="-10" endX="45" endY="-60" name="TailShade">
          <GradientStop colorValue="FF201E1A" position="0"/>
          <GradientStop colorValue="FF171512" position="0.6"/>
          <GradientStop colorValue="FF110E0C" position="1"/>
        </RadialGradient>
      </Fill>
    </Shape>

    <!-- Cushion_Inner_Depression: rounder/taller (was 85 tall, thin-looking)
         for a softer, more cushioned dip instead of a flat scalloped disc. -->
    <Shape x="250" y="350" name="cushion_inner_depression">
      <Ellipse width="345" height="108" name="Path"/>
      <Fill name="Fill">
        <RadialGradient startX="0" startY="0" endX="150" endY="40" name="DepressionShade">
          <GradientStop colorValue="FFD8C7AE" position="0"/>
          <GradientStop colorValue="FFE6D8C2" position="1"/>
        </RadialGradient>
      </Fill>
    </Shape>

    <!-- Cushion_Back: donut ring behind the cat, scaled/repositioned for
         the larger cat. -->
    <Shape x="250" y="330" name="cushion_back" id="0:302">
      <PointsPath isClosed="true" name="Path">
        <CubicMirroredVertex x="-203" y="-40" rotation="-0.55" distance="75"/>
        <CubicMirroredVertex x="-140" y="-128" rotation="-0.12" distance="70"/>
